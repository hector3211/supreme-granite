---
import { Facebook, Instagram, Twitter } from "lucide-astro";
---

<footer class="bg-primary text-white py-12">
    <div class="container mx-auto px-4">
        <div class="flex items-center justify-evenly">
            <div>
                <h3 class="text-xl font-bold mb-4">Depot Granite</h3>
                <p class="mb-4">Transforming spaces since 2000.</p>
                <div class="flex space-x-4">
                    <a
                        href="https://www.facebook.com/depotgranite"
                        target="_blank"
                        class="hover:text-primary"><Facebook size={24} /></a
                    >
                    <a href="#" class="hover:text-primary"
                        ><Instagram size={24} /></a
                    >
                    <a href="#" class="hover:text-primary"
                        ><Twitter size={24} /></a
                    >
                </div>
            </div>
            <div>
                <h4 class="text-lg font-semibold mb-4">Contact Information</h4>
                <p class="mb-2">2200 22nd St N, St. Petersburg, FL 33713</p>
                <p class="mb-2">Phone: (727) 897-9661</p>
                <p class="mb-2">Email: depotgranite@hotmail.com</p>
                <p>Mon-Fri: 9am-5pm, Sat: 10am-2pm</p>
            </div>
        </div>
        <div
            class="mt-8 pt-8 border-t border-gray-700 flex items-center justify-between"
        >
            <p>
                &copy; {new Date().getFullYear()} Depot Granite. All rights reserved.
            </p>
            <div class="flex items-center space-x-2">
                <p>Buit by</p>
                <a
                    href="https://www.hectorcodes.dev"
                    target="_blank"
                    class="font-semibold underline underline-offset-4"
                >
                    Hector Oropesa
                </a>
            </div>
        </div>
    </div>
</footer>
