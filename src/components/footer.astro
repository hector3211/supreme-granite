---
import { Facebook, Instagram, Twitter } from "lucide-astro";
---

<footer class="w-full bg-primary py-12 text-white">
    <div class="container mx-auto px-4">
        <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
            <div class="max-w-sm">
                <h3 class="text-xl font-bold mb-4">Supreme Granite</h3>
                <p class="mb-4">Transforming spaces since 2000.</p>
                <div class="flex space-x-4">
                    <a href="#" target="_blank" class="hover:text-primary"
                        ><Facebook size={24} /></a
                    >
                    <a href="#" class="hover:text-primary"
                        ><Instagram size={24} /></a
                    >
                    <a href="#" class="hover:text-primary"
                        ><Twitter size={24} /></a
                    >
                </div>
            </div>
            <div>
                <h4 class="text-lg font-semibold mb-4">Contact Information</h4>
                <p class="mb-2">1234 12nd St N, St. Petersburg, FL 12346</p>
                <p class="mb-2">Phone: (727) 777-777</p>
                <p class="mb-2">Email: SupremeGranite@email.com</p>
                <p>Mon-Fri: 9am-5pm, Sat: 10am-2pm</p>
            </div>
        </div>
        <div
            class="mt-8 flex flex-col gap-3 border-t border-gray-700 pt-8 text-sm sm:flex-row sm:items-center sm:justify-between"
        >
            <p>
                &copy; {new Date().getFullYear()} Sumpreme Granite. All rights reserved.
            </p>
            <div class="flex items-center space-x-2">
                <p>Buit by</p>
                <a
                    href="https://www.hectorcodes.dev"
                    target="_blank"
                    class="font-semibold underline underline-offset-4"
                >
                    Hector Oropesa
                </a>
            </div>
        </div>
    </div>
</footer>
