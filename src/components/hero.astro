---
import { Separator } from "@/components/ui/separator";
import NewsLetter from "@/components/news-letter.tsx";
import GridBg from "@/assets/grid-bg.svg";
import { Image } from "astro:assets";
---

<div class="relative h-screen w-full pt-20 flex flex-row-reverse">
    <div class="absolute z-0 w-full opacity-20 overflow-hidden">
        <Image
            src={GridBg}
            width={5000}
            height={1200}
            alt={"gid background"}
            class={"w-full object-cover h-[calc(100vh-5rem)] lg:h-[calc(100vh-18rem)] 2xl:h-[calc(100vh-50rem)] overflow-hidden opacity-10"}
        />
    </div>
    <div
        class="relative top-[25%] mx-auto md:top-[30%] lg:top-[18%] 2xl:top-[30%] z-20 px-4 sm:px-6 lg:px-8"
    >
        <section class="max-w-5xl">
            <h1 class="text-4xl sm:text-5xl md:text-8xl font-bold mb-4">
                Timeless Elegance With Supreme Granite
            </h1>
        </section>
        <p class="text-xl font-extralight mb-8 max-w-lg mx-auto text-center">
            Transforming spaces with nature's finest stone. Quality, durability,
            and elegance in every slab
        </p>
        <Separator className="my-4 max-w-md mx-auto" />
        {/* Newsletter Subscription */}
        <div class="max-w-xl mx-auto mt-5">
            <h3 class="text-3xl text-center font-bold my-3">News Letter</h3>
            <NewsLetter client:load />
        </div>
    </div>
</div>
