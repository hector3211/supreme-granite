---
import { Button } from "@/components/ui/button";
---

<section class="py-16 bg-gray-100">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Transform Your Space?</h2>
        <p class="mb-8 max-w-2xl mx-auto">
            Whether you're renovating your kitchen, upgrading your bathroom, or
            adding elegance to your commercial space, our expert team is here to
            bring your vision to life.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
            <Button size="lg">
                <a href={"/#contact"}> Get a Free Quote </a>
            </Button>
            <Button variant="outline" size="lg">
                <a href={"/gallery"}> View Our Portfolio </a>
            </Button>
        </div>
    </div>
</section>
