---
import ContactForm from "@/components/contactForm.tsx";
---

<section id="contact" class="bg-gray-50">
    <div class="container px-5 py-24 mx-auto flex sm:flex-nowrap flex-wrap">
        <div
            class="lg:w-2/3 md:w-1/2 rounded-lg overflow-hidden sm:mr-10 p-10 flex items-end justify-start relative"
        >
            <iframe
                width="100%"
                height="100%"
                title="map"
                class="absolute inset-0"
                src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d14122.147839495601!2d-82.6894421!3d27.7624246!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88c2e258dd5e8793%3A0x81fb349731edde37!2sGD%20Granite%20and%20Marble%20LLC!5e0!3m2!1sen!2sus!4v1694552940885!5m2!1sen!2sus"
                style="filter:  contrast(1.2) opacity(0.50);"></iframe>
        </div>
        <div
            class="lg:w-1/3 md:w-1/2 flex flex-col md:ml-auto w-full md:py-8 mt-8 md:mt-0"
        >
            <ContactForm client:load />
        </div>
    </div>
</section>
