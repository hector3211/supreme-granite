---
import ContactForm from "@/components/contactForm.tsx";
---

<section id="contact" class="py-16 bg-gray-50">
    <h2 class="text-3xl font-bold mb-8 text-center">Get In Touch</h2>
    <div
        class="container mx-auto px-4 flex flex-col-reverse items-start lg:flex-row"
    >
        <div
            class="my-3 lg:my-0 w-full lg:flex-1 h-[24rem] lg:h-[34rem] bg-zinc-900 rounded-lg overflow-hidden lg:mr-5 flex items-end justify-start relative"
        >
            <iframe
                width="100%"
                height="100%"
                loading="lazy"
                title="map"
                class="absolute inset-0 h-[34rem]"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3529.5604179174397!2d-82.66597362305872!3d27.792515721727188!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x88c2e3c43864f9a7%3A0x225de07f81490e0e!2sDepot%20Granite%20Marble%20%26%20Tile!5e0!3m2!1sen!2sus!4v1735584183963!5m2!1sen!2sus"
                style="filter:  contrast(1.2) opacity(0.9);"></iframe>
        </div>
        <ContactForm client:load />
    </div>
</section>
