---
import Hero from "@/components/hero.astro";
import SalesBanner from "@/components/banner.tsx";
import About from "@/components/about.astro";
import ProcessSection from "@/components/process.tsx";
import GallerySection from "@/components/gallery.tsx";
import Cta from "@/components/cta.astro";
import ReviewSection from "@/components/reviews.tsx";
import Questions from "@/components/questions.tsx";
import ContactForm from "@/components/contactForm.tsx";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main>
        <Hero />
        <SalesBanner client:load />
        <About />
        <ProcessSection client:load />
        <GallerySection client:load />
        <Cta />
        <Questions client:load />
        <ReviewSection client:load />
        <ContactForm client:load />
    </main>
</Layout>
